<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZenFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/zen_primary</item>

        <item name="android:colorBackground">@color/zen_dark_background</item>
        <item name="colorSurface">@color/zen_dark_background</item>
        <item name="colorSurfaceVariant">@color/zen_dark_card</item>

        <item name="colorOnBackground">@color/zen_dark_text</item>
        <item name="colorOnSurface">@color/zen_dark_text</item>
        <item name="colorOnPrimary">@color/zen_light_text</item>
        <item name="android:textColorSecondary">@color/zen_dark_text_secondary</item>
    </style>

    <style name="Theme.ZenFlow.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="dialogCornerRadius">24dp</item>
    </style>
</resources>