<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/zenflow_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/zenflow_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZenFlow">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main" />

        <activity
            android:name=".ui.moods.MoodChartActivity"
            android:theme="@style/Theme.ZenFlow" />

        <activity
            android:name=".SignupActivity"
            android:exported="false" />

        <activity
            android:name=".SigninActivity"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity3"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity2"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity1"
            android:exported="false" />

    </application>

</manifest>